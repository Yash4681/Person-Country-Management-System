@{
    ViewBag.Title = "Upload from excel";
}

<div class="flex">
    <div class="flex-1">
        <div class="text-grey">
            <span>Contacts</span>
            <i class="fa-solid fa-caret-right"></i>
            <span>Countries</span>
            <i class="fa-solid fa-caret-right"></i>
            <span>Upload</span>
        </div>
    </div>
</div>

<div class="form-container">
    <h2 class="text-large">Upload Countries from Excel</h2>

    <form asp-controller="Countries" asp-action="UploadFromExcel" method="post" enctype="multipart/form-data">
        <div class="form-field flex">
            <div class="w-25">
                <label>Upload your excel file: </label>
            </div>
            <div class="flex-1">
                <input type="file" name="excelFile" />
                <div class="text-red">@ViewBag.ErrorMessage</div>
                <div class="text-green">@ViewBag.Message</div>
            </div>
        </div>
        <div class="form-field flex">
            <div class="w-25"></div>
            <div class="flex-1">
                <button type="submit" class="button button-green-back">Upload</button>
            </div>
        </div>
    </form>
</div>